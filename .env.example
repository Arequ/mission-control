# Local development only. These values are not production secrets.
DATABASE_URL=postgres://missioncontrol:missioncontrol@127.0.0.1:5432/missioncontrol?sslmode=disable
MC_HTTP_ADDR=:8080
MC_ADMIN_TOKEN=mc_dev_admin_token
MC_BOOTSTRAP_TOKEN=mc_dev_bootstrap_token
MC_REPO_TOKEN=mc_dev_repo_token
MC_STORAGE_DRIVER=local
MC_STORAGE_DIR=data
MC_WEB_DIR=web/dist
# MC_STORAGE_DRIVER=s3
# MC_S3_ENDPOINT=127.0.0.1:9000
# MC_S3_BUCKET=mission-control
# MC_S3_ACCESS_KEY=
# MC_S3_SECRET_KEY=
# MC_S3_USE_SSL=false
# Jump the scheduler clock so a 7-day soak elapses immediately.
# MC_CLOCK_OFFSET=168h
# MC_DEV_SEED=1
# Devices with no check-in inside this window are offline. Compose uses 24h so the seeded fleet stays online.
# MC_OFFLINE_AFTER=45s
# Built-in osquery inventory snapshot interval.
# MC_INVENTORY_INTERVAL=5m
# Optional Elasticsearch _bulk forwarder for osquery result logs. Leave the URL empty to disable it.
# MC_ELASTIC_URL=https://es.example:9200
# MC_ELASTIC_INDEX=osquery-results
# MC_ELASTIC_API_KEY=
