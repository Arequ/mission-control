# Local development only. Do not use these values anywhere but a private workstation.
MC_HTTP_ADDR=:8080
MC_DATABASE_URL=postgres://missioncontrol:missioncontrol@localhost:5432/missioncontrol?sslmode=disable
MC_BOOTSTRAP_TOKEN=dev-bootstrap-token
MC_ENROLL_SECRET=dev-enroll-secret
MC_CONFIG_DIR=./examples/config
MC_CONFIG_SYNC_INTERVAL=30s
MC_CONFIG_GIT_PULL=false
MC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MC_WEB_DIR=
MC_BLOB_DRIVER=local
MC_BLOB_DIR=./data/blobs
